{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreLeaf",
  "version": "0.0.3",
  "identifier": "io.github.eagnespuerto.libreleaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "LibreLeaf", "width": 1200, "height": 820, "minWidth": 640, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "The LaTeX word processor for independent researchers",
    "longDescription": "LibreLeaf is a free, open-source word processor that reads and writes LaTeX. This is an early draft.",
    "copyright": "Copyright (C) 2026 Ella Agnes Puerto. AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "section": "editors" } }
  }
}
